# Configuration de l'application — copier vers .env (jamais commité)
# Préfixe des variables : APP_

# Répertoire de données (base SQLite, backups/, logs/)
APP_DATA_DIR=data

# Couche LLM (compatible OpenAI) — Ollama local par défaut (dev, coût nul)
APP_LLM_BASE_URL=http://localhost:11434/v1
APP_LLM_API_KEY=

# Modèles par phase (2 à 6) — vide = non configuré
APP_MODELE_PHASE2=
APP_MODELE_FORME=
APP_MODELE_STYLE=
APP_MODELE_TECHNIQUE=
APP_MODELE_EMBELLISSEMENT=

# Garde-fous et timeouts (v6 §2.2)
APP_MAX_CARACTERES=30000
APP_TIMEOUT_PHASE=90
APP_TIMEOUT_PING=10
APP_RETRIES_PING=1
APP_BACKUPS_MAX=20
APP_MODE_DEBUG=false

# Variante linguistique : france | quebec | belgique
APP_VARIANTE=france

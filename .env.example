# Configuration de l'application — copier vers .env (jamais commité)
# Préfixe des variables : APP_

# Répertoire de données (base SQLite, backups/, logs/)
APP_DATA_DIR=data

# Fournisseur UNIQUE : Mistral par clé API (décision de l'auteur — pas de LLM local)
APP_LLM_BASE_URL=https://api.mistral.ai/v1
APP_LLM_API_KEY=votre_cle_api_mistral

# Modèles par phase (2 à 6) — vide = non configuré
APP_MODELE_PHASE2=mistral-small-latest
APP_MODELE_FORME=mistral-small-latest
APP_MODELE_STYLE=mistral-small-latest
APP_MODELE_TECHNIQUE=mistral-small-latest
APP_MODELE_EMBELLISSEMENT=mistral-small-latest

# Garde-fous et timeouts (v6 §2.2)
APP_MAX_CARACTERES=30000
APP_TIMEOUT_PHASE=90
APP_TIMEOUT_PING=10
APP_RETRIES_PING=1
APP_BACKUPS_MAX=20
APP_MODE_DEBUG=false

# Variante linguistique : france | quebec | belgique
APP_VARIANTE=france
